<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- Settings list element with a color swatch in the control column; see Options.lua -->
    <Frame name="RogueEnergyCPColorControlTemplate" inherits="SettingsControlTemplate" mixin="RogueEnergyCPColorControlMixin" virtual="true">
        <Frames>
            <Button parentKey="Swatch">
                <Size x="64" y="18"/>
                <Anchors>
                    <Anchor point="LEFT" relativePoint="CENTER" x="-80" y="0"/>
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture setAllPoints="true">
                            <Color r="0" g="0" b="0" a="1"/>
                        </Texture>
                    </Layer>
                    <Layer level="ARTWORK">
                        <Texture parentKey="Color">
                            <Anchors>
                                <Anchor point="TOPLEFT" x="1" y="-1"/>
                                <Anchor point="BOTTOMRIGHT" x="-1" y="1"/>
                            </Anchors>
                            <Color r="1" g="1" b="1" a="1"/>
                        </Texture>
                    </Layer>
                    <Layer level="HIGHLIGHT">
                        <Texture setAllPoints="true" alphaMode="ADD">
                            <Color r="1" g="1" b="1" a="0.2"/>
                        </Texture>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnClick>
                        self:GetParent():OpenPicker()
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>
    </Frame>
</Ui>
